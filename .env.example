# ==============================================================================
# VELOURA DOTS - Environment Configuration Template
# Copy this file to '.env' and fill in your local or production credentials.
# ==============================================================================

# Server Port (Default: 5500)
PORT=5500

# Node Environment ('development' or 'production')
NODE_ENV=development

# Admin Portal Passcode (Required for Admin API Endpoints & Dashboard Access)
ADMIN_PASSCODE=veloura2026

# PostgreSQL Database Connection String (Required)
# Example for local: postgresql://postgres:postgres@localhost:5432/veloura_dots
# Example for Cloud: postgresql://user:pass@ep-cool-db.us-east-1.aws.neon.tech/veloura_dots?sslmode=require
DATABASE_URL=

# Nodemailer SMTP Email Configuration (Optional - falls back to Ethereal / console logs)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STUDIO_EMAIL=studio@veloura.art

# Vercel Blob Storage Token (Required for running 'npm run blob:upload' or uploading to Vercel Blob locally)
# Copy BLOB_READ_WRITE_TOKEN from Vercel Dashboard -> Storage -> Blob -> Settings / .env.local
BLOB_READ_WRITE_TOKEN=

